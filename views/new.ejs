<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Create New Listing</title>
</head>
<body>
    <h3>Create a New Listing</h3>

    
    <form method="POST" action="/listings">
        <div>
            <label for="title">Title:</label>
            <input type="text" id="title" name="listing[title]" placeholder="Add a catchy title" required />
        </div>
        <br>
        <div>
            <label for="description">Description:</label>
            <textarea id="description" name="listing[description]" placeholder="Enter description" required></textarea>
        </div>
        <br>
        <div>
            <label for="image">Image URL:</label>
            <input type="text" id="image" name="listing[image]" placeholder="Enter image URL/link" />
        </div>
        <br>
        <div>
            <label for="price">Price:</label>
            <input type="number" id="price" name="listing[price]" placeholder="1200" required />
        </div>
        <br>
        <div>
            <label for="location">Location:</label>
            <input type="text" id="location" name="listing[location]" placeholder="Jaipur, Rajasthan" required />
        </div>
        <br>
        <div>
            <label for="country">Country:</label>
            <input type="text" id="country" name="listing[country]" placeholder="India" required />
        </div>
        <br>
        <button type="submit">Add Listing</button>
    </form>
</body>
</html>